# Configure these values in Coolify, not in a committed production .env file.
RP_ID=gym.example.com
ORIGIN=https://gym.example.com
RP_NAME=openGym

ALLOW_GUEST=0
INVITE_ONLY=0
PASSWORD_LOGIN=0
FIRST_USER_ADMIN=0
DEFAULT_LANG=
SESSION_DAYS=90
COACH_DISABLED=

PORT=3000
NGINX_PORT=80
TRUST_PROXY=1
MEDIA_UPLOAD_MAX=48m

# Leave blank unless the source instance uses these options. Enter real values
# only in Coolify's Environment Variables screen.
ADMIN_UIDS=
CF_CONNECTING_IP=
BASE_PATH=
